# Add LiSetVideoReorderWaitUs to tune or turn off the reorder wait
# Origin: juanjsebgarcia (juanjsebgarcia/moonlight-common-c, branch reorder-window)

# 0 restores the previous behaviour, which also lets clients compare the
# two in the same conditions.
# 
# Signed-off-by: juanjsebgarcia <github@juangarcia.co.uk>
# 
diff --git a/src/Limelight.h b/src/Limelight.h
index 038ad4b..450997e 100644
--- a/src/Limelight.h
+++ b/src/Limelight.h
@@ -911,6 +911,12 @@ typedef struct _RTP_VIDEO_STATS {
 
 const RTP_VIDEO_STATS* LiGetRTPVideoStats(void);
 
+// How long to hold the next frame's packets while the current frame is still
+// incomplete, in case its late packets are on their way (packets can arrive
+// out of order on Wi-Fi). 0 restores giving up on the frame immediately. The
+// default is 10 ms. Takes effect for packets received after the call.
+void LiSetVideoReorderWaitUs(uint32_t waitUs);
+
 // Port index flags for use with LiGetPortFromPortFlagIndex() and LiGetProtocolFromPortFlagIndex()
 #define ML_PORT_INDEX_TCP_47984 0
 #define ML_PORT_INDEX_TCP_47989 1
diff --git a/src/RtpVideoQueue.c b/src/RtpVideoQueue.c
index 7ba63a4..2b3591a 100644
--- a/src/RtpVideoQueue.c
+++ b/src/RtpVideoQueue.c
@@ -24,9 +24,15 @@
 // case this frame's stragglers are still coming. Without reordering nothing
 // is held, so this costs nothing; with a real loss, the next frame is
 // delayed by at most the wait.
-#define RTPV_REORDER_WAIT_US 10000
+#define RTPV_REORDER_WAIT_US_DEFAULT 10000
 #define RTPV_REORDER_MAX_HELD_PACKETS 256
 
+static uint32_t reorderWaitUs = RTPV_REORDER_WAIT_US_DEFAULT;
+
+void LiSetVideoReorderWaitUs(uint32_t waitUs) {
+    reorderWaitUs = waitUs;
+}
+
 void RtpvInitializeQueue(PRTP_VIDEO_QUEUE queue) {
     reed_solomon_init();
     memset(queue, 0, sizeof(*queue));
@@ -637,11 +643,11 @@ static int addConvertedPacket(PRTP_VIDEO_QUEUE queue, PRTP_PACKET packet, int le
 
     // A packet of the next frame while this one is still incomplete: hold it
     // back for a little while, in case this frame's late packets turn up
-    if (!queue->replayingEarlyPackets && queue->pendingFecBlockList.count != 0 &&
+    if (reorderWaitUs != 0 && !queue->replayingEarlyPackets && queue->pendingFecBlockList.count != 0 &&
             nvPacket->frameIndex == queue->currentFrameNumber + 1) {
         if (queue->earlyPacketList.count < RTPV_REORDER_MAX_HELD_PACKETS &&
                 (queue->earlyPacketList.count == 0 ||
-                 PltGetMicroseconds() - queue->earlyPacketHoldStartUs < RTPV_REORDER_WAIT_US)) {
+                 PltGetMicroseconds() - queue->earlyPacketHoldStartUs < reorderWaitUs)) {
             holdEarlyPacket(queue, packetEntry, packet, length);
             return RTPF_RET_QUEUED;
         }
diff --git a/src/RtpVideoQueue.h b/src/RtpVideoQueue.h
index e138213..63a3a26 100644
--- a/src/RtpVideoQueue.h
+++ b/src/RtpVideoQueue.h
@@ -25,7 +25,7 @@ typedef struct _RTP_VIDEO_QUEUE {
 
     // Packets of the next frame that arrived while the current frame was still
     // incomplete, held back in arrival order in case the current frame's late
-    // packets are still on their way (see RTPV_REORDER_WAIT_US)
+    // packets are still on their way (see LiSetVideoReorderWaitUs)
     RTPV_QUEUE_LIST earlyPacketList;
     uint64_t earlyPacketHoldStartUs;
     bool replayingEarlyPackets;
